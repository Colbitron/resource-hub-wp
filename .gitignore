# Environment files, including what `vercel env pull` writes. Secrets never go in
# git; a .env.example with names and no values is the documented exception.
.env*
!.env.example

# The Vercel CLI's project link (project and org IDs) from `vercel deploy` or `vercel link`.
.vercel

node_modules/
vendor/

# Third-party WordPress plugins, which Composer installs from site-plugins/composer.lock; only our
# own plugin is committed.
/wp-content/plugins/*
!/wp-content/plugins/resource-hub-wp/
.DS_Store

.wp-env.override.json
.phpunit.result.cache
build/
artifacts/
