{
	"name": "resource-hub-wp",
	"version": "0.1.0",
	"private": true,
	"description": "WordPress plugin and wp-env environment for the Resource Hub headless demo.",
	"license": "GPL-2.0-or-later",
	"packageManager": "pnpm@12.16.1",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.16.1",
			"onFail": "download"
		}
	},
	"scripts": {
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:destroy": "wp-env destroy",
		"wp": "wp-env run cli wp",
		"wp:tests": "wp-env run tests-cli wp",
		"composer": "wp-env run cli --env-cwd=wp-content/plugins/resource-hub-wp composer",
		"lint": "wp-env run cli --env-cwd=wp-content/plugins/resource-hub-wp composer lint",
		"lint:fix": "wp-env run cli --env-cwd=wp-content/plugins/resource-hub-wp composer lint:fix",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/resource-hub-wp composer test",
		"build": "wp-scripts build --webpack-src-dir=blocks",
		"start": "wp-scripts start --webpack-src-dir=blocks",
		"lint:js": "wp-scripts lint-js blocks editor tests/e2e playwright.config.js webpack.config.js",
		"format": "wp-scripts format blocks editor tests/e2e playwright.config.js webpack.config.js",
		"test:e2e": "wp-scripts test-playwright",
		"test:e2e:debug": "wp-scripts test-playwright --debug"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@wordpress/block-editor": "^19.0.0",
		"@wordpress/blocks": "^17.0.0",
		"@wordpress/components": "^43.0.0",
		"@wordpress/core-data": "^9.0.0",
		"@wordpress/data": "^11.0.0",
		"@wordpress/e2e-test-utils-playwright": "^3.1.0",
		"@wordpress/editor": "^16.0.0",
		"@wordpress/env": "^12.0.0",
		"@wordpress/i18n": "^7.0.0",
		"@wordpress/plugins": "^8.0.0",
		"@wordpress/scripts": "^37.0.0",
		"@wordpress/server-side-render": "^7.0.0"
	}
}
