{
	"name": "resource-hub",
	"version": "0.1.0",
	"private": true,
	"description": "Resource Hub headless WordPress demo: the WordPress plugin, the Next.js front end and the contract package they share, in one workspace.",
	"license": "GPL-2.0-or-later",
	"packageManager": "pnpm@12.16.1",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.16.1",
			"onFail": "download"
		}
	},
	"scripts": {
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:destroy": "wp-env destroy",
		"wp": "wp-env run cli wp",
		"wp:tests": "wp-env run tests-cli wp",
		"composer": "wp-env run cli --env-cwd=wp-content/plugins/resource-hub-wp composer",
		"lint": "wp-env run cli --env-cwd=wp-content/plugins/resource-hub-wp composer lint",
		"lint:fix": "wp-env run cli --env-cwd=wp-content/plugins/resource-hub-wp composer lint:fix",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/resource-hub-wp composer test",
		"build": "pnpm --filter resource-hub-wp build",
		"start": "pnpm --filter resource-hub-wp start",
		"lint:js": "pnpm --filter resource-hub-wp lint:js",
		"format": "pnpm --filter resource-hub-wp format",
		"test:e2e": "pnpm --filter resource-hub-wp test:e2e",
		"test:e2e:debug": "pnpm --filter resource-hub-wp test:e2e:debug",
		"test:schemas": "pnpm --filter @colbitron/resource-hub-ui test",
		"web:dev": "pnpm --filter resource-hub-web dev",
		"web:lint": "pnpm --filter resource-hub-web lint",
		"web:typecheck": "pnpm --filter resource-hub-web typecheck",
		"web:build": "pnpm --filter resource-hub-web build",
		"web:test": "pnpm --filter resource-hub-web test",
		"web:test:e2e": "pnpm --filter resource-hub-web test:e2e",
		"web:test:dev": "pnpm --filter resource-hub-web test:dev",
		"web:test:screenshots": "pnpm --filter resource-hub-web test:screenshots",
		"web:test:screenshots:update": "pnpm --filter resource-hub-web test:screenshots:update",
		"web:test:lighthouse": "pnpm --filter resource-hub-web test:lighthouse",
		"images:generate": "node tools/featured-images/generate.mts",
		"images:import": "tools/featured-images/import.sh"
	},
	"devDependencies": {
		"@wordpress/env": "^12.0.0"
	}
}
