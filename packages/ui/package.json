{
	"name": "@colbitron/resource-hub-ui",
	"version": "0.1.0",
	"private": true,
	"description": "The contract between the Resource Hub WordPress plugin and its Next.js front end: JSON Schemas (draft 2020-12), the shared stylesheets and the typeface, with the visual system written up in DESIGN.md.",
	"license": "GPL-2.0-or-later",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Colbitron/resource-hub-wp.git",
		"directory": "packages/ui"
	},
	"files": [
		"schemas",
		"fonts",
		"tokens.css",
		"card.css",
		"README.md",
		"DESIGN.md"
	],
	"exports": {
		"./schemas/*": "./schemas/*",
		"./fonts/*": "./fonts/*",
		"./tokens.css": "./tokens.css",
		"./card.css": "./card.css"
	},
	"scripts": {
		"test": "node --test"
	},
	"devDependencies": {
		"ajv": "^8.17.1",
		"ajv-formats": "^3.0.1",
		"fontkit": "^2.0.4"
	}
}
