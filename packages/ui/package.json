{
	"name": "@colbitron/resource-hub-ui",
	"version": "0.1.0",
	"private": true,
	"description": "The contract between the Resource Hub WordPress plugin and its Next.js front end: JSON Schemas (draft 2020-12), the shared stylesheets, the type-accent table and the typeface, with the visual system written up in DESIGN.md.",
	"license": "GPL-2.0-or-later",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Colbitron/resource-hub-wp.git",
		"directory": "packages/ui"
	},
	"files": [
		"schemas",
		"fonts",
		"brand",
		"tokens.css",
		"card.css",
		"card-labels.css",
		"brand.css",
		"base.css",
		"theme-toggle.css",
		"prose.css",
		"related.css",
		"lead.css",
		"listing.css",
		"not-found.css",
		"resource.css",
		"page.css",
		"type-accents.json",
		"README.md",
		"DESIGN.md"
	],
	"exports": {
		"./schemas/*": "./schemas/*",
		"./fonts/*": "./fonts/*",
		"./brand/*": "./brand/*",
		"./tokens.css": "./tokens.css",
		"./card.css": "./card.css",
		"./card-labels.css": "./card-labels.css",
		"./brand.css": "./brand.css",
		"./base.css": "./base.css",
		"./theme-toggle.css": "./theme-toggle.css",
		"./prose.css": "./prose.css",
		"./related.css": "./related.css",
		"./lead.css": "./lead.css",
		"./listing.css": "./listing.css",
		"./not-found.css": "./not-found.css",
		"./resource.css": "./resource.css",
		"./page.css": "./page.css",
		"./type-accents.json": "./type-accents.json"
	},
	"scripts": {
		"test": "node --test"
	},
	"devDependencies": {
		"ajv": "^8.17.1",
		"ajv-formats": "^3.0.1",
		"fontkit": "^2.0.4"
	}
}
