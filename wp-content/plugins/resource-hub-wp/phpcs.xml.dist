<?xml version="1.0"?>
<ruleset name="Resource Hub">
	<description>WordPress Coding Standards as the base, the WordPress VIP Minimum ruleset added to it, and the PSR-12 sniffs that do not conflict with either layered on top.</description>

	<!-- Where WordPress and PSR-12 disagree, WordPress wins, so the code reads like core and every other WordPress plugin.
	     Rejected for the same reason: PSR-12 as the base with WordPress on top, and PSR-12 alone with WordPress-Extra for
	     the security sniffs. -->

	<file>resource-hub.php</file>
	<file>src</file>
	<file>tests</file>
	<!-- The CMS block theme's PHP, beside the plugin in wp-content/ and held to the same standard. -->
	<file>../../themes/resource-hub</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<config name="minimum_wp_version" value="6.9"/>
	<config name="testVersion" value="8.4-"/>

	<rule ref="WordPress">
		<!-- PSR-4 classes live in src/ with StudlyCase file names, not class-*.php. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ResourceHub"/>
				<element value="resource_hub"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="resource-hub"/>
			</property>
		</properties>
	</rule>

	<!-- VIP Minimum, not WordPress-VIP-Go: VIP-Go relaxes sniffs for VIP's own infrastructure (permitted file writes, a meta_key/meta_value
	     index, trusted translations), which Cloudways and wp-env lack. Minimum swaps some WordPress sniffs for stricter VIP ones but drops
	     three outright (MissingUnslash and two trailing-whitespace checks); they are restored below. -->
	<rule ref="WordPressVIPMinimum"/>
	<!-- Minimum excludes MissingUnslash; we want wp_unslash() before sanitising input, so restore it. A bare ref does not. -->
	<rule ref="WordPress.Security.ValidatedSanitizedInput.MissingUnslash">
		<severity>5</severity>
	</rule>
	<!-- Minimum also excludes the trailing-whitespace check that WordPress enforces; restore it. -->
	<rule ref="Squiz.WhiteSpace.SuperfluousWhitespace.EndLine">
		<severity>5</severity>
	</rule>
	<!-- The PHPUnit bootstrap includes the core test library from WP_TESTS_DIR by design: there is no fixed path to write,
	     and it is the only file where that is true. -->
	<rule ref="WordPressVIPMinimum.Files.IncludingFile">
		<exclude-pattern>*/tests/phpunit/bootstrap\.php$</exclude-pattern>
	</rule>

	<rule ref="PSR12">
		<!-- Where PSR-12 and WordPress disagree, WordPress wins. Each group of exclusions names its conflict. -->
		<exclude name="Generic.WhiteSpace.DisallowTabIndent"/><!-- WP indents with tabs. -->
		<exclude name="Generic.Files.LineLength"/><!-- WP has no hard line limit. -->
		<exclude name="PSR2.Classes.ClassDeclaration"/><!-- WP keeps the opening brace on the class line. -->
		<exclude name="PSR2.Methods.FunctionClosingBrace"/>
		<exclude name="Squiz.Functions.MultiLineFunctionDeclaration"/><!-- WP keeps the opening brace on the function line. -->
		<exclude name="Squiz.ControlStructures.ControlSignature"/><!-- WP spaces inside parentheses. -->
		<exclude name="PSR2.ControlStructures.ControlStructureSpacing"/>
		<exclude name="PSR12.ControlStructures.ControlStructureSpacing"/>
		<exclude name="PSR2.Methods.FunctionCallSignature"/><!-- WP spaces inside call parentheses. -->
		<exclude name="Generic.Functions.FunctionCallArgumentSpacing"/>
		<exclude name="PSR1.Methods.CamelCapsMethodName"/><!-- WP methods are snake_case. -->
		<exclude name="PSR12.Files.FileHeader"/><!-- WP plugin headers and ABSPATH guards precede declarations. -->
		<exclude name="PSR12.Files.OpenTag"/>
		<exclude name="PSR1.Files.SideEffects"/><!-- The plugin entry file both declares and executes by design. -->
		<exclude name="PSR12.Classes.ClassInstantiation"/>
		<exclude name="PSR12.Operators.OperatorSpacing"/>
		<exclude name="PSR2.Namespaces.UseDeclaration"/>
		<exclude name="PSR12.Properties.ConstantVisibility"/>
	</rule>

	<!-- WordPress forbids stacked blank lines inside functions; PSR-12 silences that check (severity 0) and Minimum excludes it.
	     WordPress wins, so it is restored here, after the PSR-12 block, where it takes effect. -->
	<rule ref="Squiz.WhiteSpace.SuperfluousWhitespace.EmptyLines">
		<severity>5</severity>
	</rule>

	<rule ref="PHPCompatibilityWP"/>
</ruleset>
