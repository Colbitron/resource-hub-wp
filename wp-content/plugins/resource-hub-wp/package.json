{
	"name": "resource-hub-wp",
	"version": "0.1.0",
	"private": true,
	"description": "The Resource Hub WordPress plugin: block and editor-panel build, JavaScript lint, and the Playwright smoke tests. PHP tooling runs through Composer in the wp-env containers from the workspace root.",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "wp-scripts build --webpack-src-dir=blocks",
		"start": "wp-scripts start --webpack-src-dir=blocks",
		"lint:js": "wp-scripts lint-js admin blocks editor tests/e2e playwright.config.js webpack.config.js",
		"format": "wp-scripts format admin blocks editor tests/e2e playwright.config.js webpack.config.js",
		"test:e2e": "wp-scripts test-playwright",
		"test:e2e:debug": "wp-scripts test-playwright --debug"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@colbitron/resource-hub-ui": "workspace:*",
		"@playwright/test": "^1.64.1",
		"@wordpress/a11y": "^5.0.0",
		"@wordpress/api-fetch": "^8.0.0",
		"@wordpress/block-editor": "^19.0.0",
		"@wordpress/blocks": "^17.0.0",
		"@wordpress/components": "^43.0.0",
		"@wordpress/core-data": "^9.0.0",
		"@wordpress/data": "^11.0.0",
		"@wordpress/e2e-test-utils-playwright": "^3.1.0",
		"@wordpress/editor": "^16.0.0",
		"@wordpress/element": "^10.0.0",
		"@wordpress/hooks": "^5.0.0",
		"@wordpress/html-entities": "^5.0.0",
		"@wordpress/i18n": "^7.0.0",
		"@wordpress/notices": "^6.0.0",
		"@wordpress/plugins": "^8.0.0",
		"@wordpress/scripts": "^37.0.0",
		"@wordpress/server-side-render": "^7.0.0",
		"@wordpress/url": "^5.0.0"
	}
}
