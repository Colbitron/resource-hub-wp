# Base URL of the WordPress REST API (the CMS's /wp-json), e.g. http://localhost:8888/wp-json for local wp-env.
WP_API_URL=
# Shared secret the CMS sends as "Authorization: Bearer ..." to POST /api/revalidate/. Generate a long random string.
REVALIDATE_SECRET=
# Optional. Origin (scheme, host and port, no path) that /media/... is rewritten to, as /wp-content/uploads/...
# Leave empty to use the origin of WP_API_URL; set it only when uploads are served from another host.
WP_MEDIA_ORIGIN=
