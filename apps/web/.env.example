# Base URL of the WordPress REST API (the CMS's /wp-json), e.g. http://localhost:8888/wp-json for local wp-env.
WP_API_URL=
# Shared secret the CMS sends as "Authorization: Bearer ..." to POST /api/revalidate/.
# `REVALIDATE_SECRET` is 32 to 256 printable ASCII characters with no whitespace; both sides refuse anything else.
# No trailing newline either. Generate a long random string.
REVALIDATE_SECRET=
# Optional. Site base that /media/... is rewritten under, as {base}/wp-content/uploads/...: an origin, optionally
# with the path WordPress is installed in (https://example.com/blog). Leave empty to use WP_API_URL without /wp-json;
# set it only when uploads are served from another host or path.
WP_MEDIA_ORIGIN=
# The site's public origin, e.g. https://resources.example: https, or http only for localhost, with no path, query,
# fragment or credentials. The root layout sets it as metadataBase, so the canonical link, og:url and og:image are
# absolute. Optional locally (they stay relative); a Vercel build fails without it.
SITE_URL=
